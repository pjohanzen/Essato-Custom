# reCAPTCHA configuration
# The browser uses the site key to mint a token.
# The backend must keep the secret key private and verify the token with Google.
RECAPTCHA_SITE_KEY=your-public-site-key
RECAPTCHA_SECRET_KEY=your-private-secret-key
RECAPTCHA_SCORE_THRESHOLD=0.5
RECAPTCHA_ALLOWED_HOSTNAMES=esattocustom.com,www.esattocustom.com

# Google Apps Script note:
# If this site is deployed through Apps Script, set the same values in
# Project Settings -> Script Properties using the keys above.
